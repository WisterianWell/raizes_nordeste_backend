          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Tapioca de carne\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/produtos/",
            "description": "T04 - Campo obrigatório ausente.\nPré-condição: logado como ADMIN.\nEntrada: cadastro de produto sem o campo obrigatório 'categoria' (mesmo exemplo de erro do relatório, 5.6.1).\nSaída esperada: 422, error=VALIDATION_ERROR, details aponta o campo categoria."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));",
                  "const data = pm.response.json();",
                  "pm.test(\"Detalhe aponta o campo categoria\", () => {",
