  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login válido",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{admin_email}}", "type": "text" },
                { "key": "password", "value": "{{admin_senha}}", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/v1/auth/login",
            "description": "T01 - Login com token válido.\nPré-condição: usuário já deve estar cadastrado (admin seedado via ADMIN_EMAIL/ADMIN_SENHA).\nEntrada: {username, password} - e-mail e senha do admin.\nSaída esperada: 200, access_token e refresh_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Retornou access_token e refresh_token\", () => {",
                  "    pm.expect(data).to.have.property(\"access_token\");",
                  "    pm.expect(data).to.have.property(\"refresh_token\");",
                  "});",
                  "pm.collectionVariables.set(\"access_token\", data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Acesso sem token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/produtos/",
            "description": "T02 - Acesso sem token.\nPré-condição: nenhuma (sem header Authorization).\nEntrada: GET /v1/produtos/ sem token.\nSaída esperada: 401, envelope de erro padrão {error, message, details, timestamp, path}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "const data = pm.response.json();",
                  "pm.test(\"Envelope de erro padrão\", () => {",
                  "    pm.expect(data).to.have.property(\"error\");",
                  "    pm.expect(data).to.have.property(\"message\");",
                  "});",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
