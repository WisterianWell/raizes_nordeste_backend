            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"forma_pagamento\": \"PIX\", \"force_status\": \"APROVADO\", \"pontos_resgatados\": 0}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/pagamentos/{{id_pedido}}",
            "description": "T09 - Pagamento mock aprovado e status atualizado.\nPré-condição: pedido criado em T06, ainda sem pagamento.\nEntrada: mesmo body de exemplo do relatório (5.11.1).\nSaída esperada: 201, status = APROVADO; status_pagamento do pedido passa a APROVADO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Pagamento aprovado\", () => pm.expect(data.status).to.eql(\"APROVADO\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Criar segundo pedido (para pagamento recusado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_cliente}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"id_unidade\": {{id_unidade}}, \"canal\": \"PICKUP\", \"itens\": [{\"id_produto\": {{id_produto_tapioca}}, \"quantidade\": 1}]}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/pedidos/",
            "description": "Pré-condição: um pedido não pode ser pago duas vezes (PEDIDO_JA_PAGO), então T10 precisa de um pedido novo.\nSaída esperada: 201, id_pedido salvo em id_pedido_recusado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"id_pedido_recusado\", data.id_pedido);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagamento recusado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_cliente}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"forma_pagamento\": \"PIX\", \"force_status\": \"RECUSADO\", \"pontos_resgatados\": 0}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/pagamentos/{{id_pedido_recusado}}",
            "description": "T10 - Pagamento mock recusado.\nPré-condição: segundo pedido criado, ainda sem pagamento.\nEntrada: force_status RECUSADO (gateway mock).\nSaída esperada: 201, status = RECUSADO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Pagamento recusado\", () => pm.expect(data.status).to.eql(\"RECUSADO\"));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auditoria",
      "item": [
        {
          "name": "Log de ação sensível (criação do pedido)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/auditoria/?entidade=PEDIDO&acao=CRIACAO&id_entidade={{id_pedido}}",
            "description": "T11 - Ação sensível gerando registro de auditoria.\nPré-condição: logado como ADMIN; pedido criado em T06 (ação sensível CRIACAO/PEDIDO).\nEntrada: filtro entidade=PEDIDO, acao=CRIACAO, id_entidade do pedido de T06 (mesmo padrão de filtro do relatório, 5.13.1).\nSaída esperada: 200, lista com ao menos 1 log referente ao pedido criado em T06."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const logs = pm.response.json();",
                  "pm.test(\"Existe ao menos um log de criação de pedido\", () => pm.expect(logs.length).to.be.above(0));",
                  "const idPedido = parseInt(pm.collectionVariables.get(\"id_pedido\"));",
                  "pm.test(\"Log corresponde ao pedido criado em T06\", () => {",
                  "    const encontrado = logs.some((log) => log.id_entidade === idPedido);",
                  "    pm.expect(encontrado).to.be.true;",
                  "});",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
